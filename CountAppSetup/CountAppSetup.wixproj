<Project Sdk="WixToolset.Sdk/7.0.0">
    <PropertyGroup>
        <AcceptEula>wix7</AcceptEula>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\CountApp\CountApp.csproj" />
    </ItemGroup>
	<ItemGroup>
		<PackageReference Include="WixToolset.Heat" Version="6.0.2" />
	</ItemGroup>
	<ItemGroup>
		<HarvestDirectory Include="..\CountApp\bin\$(Configuration)\net8.0\">
			<ComponentGroupName>HarvestedComponents</ComponentGroupName>
			<DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
			<SuppressRootDirectory>true</SuppressRootDirectory>
		</HarvestDirectory>
	</ItemGroup>
</Project>